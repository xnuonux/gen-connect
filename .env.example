# anthropic claude (planning + drafting + judge)
ANTHROPIC_API_KEY=

# supabase (auth + postgres + rls)
# the NEXT_PUBLIC_ pair is what the browser client reads ... required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# sending (resend primary, sendgrid swappable)
RESEND_API_KEY=
SENDGRID_API_KEY=

# enrichment + signals
APIFY_TOKEN=
APOLLO_API_KEY=
CRAWL4AI_API_URL=

# perplexity (sonar enrichment)
PERPLEXITY_API_KEY=

# booking conversion
CAL_COM_API_KEY=

# observability
SENTRY_DSN=
POSTHOG_KEY=

# rate limiting + gen copilot cost guards
# upstash powers the per-user rate limit on /api/gen ... absent = always-allow (dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEN_RATE_LIMIT_MAX=20         # max /api/gen calls per user per minute
GEN_DAILY_CEILING_CENTS=500   # paid-plan daily spend cap in cents (~$5/day)

# app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# openrouter gateway (routes to anthropic + deepseek via one key)
OPENROUTER_API_KEY=
