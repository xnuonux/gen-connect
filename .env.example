# gen connect env ... every var the code reads, grouped by concern.
# placeholder values only. copy to .env.local for dev; set the same names in
# vercel for prod. safe by default: nothing sends to a real lead and billing is
# switched off until you deliberately flip the flags noted below.

# ---------------------------------------------------------------------------
# app / site url
# ---------------------------------------------------------------------------
# the public origin of the app. drives the magic-link redirect, stripe
# checkout success/cancel urls, and unsubscribe links in mail footers.
# required for prod (defaults to http://localhost:3001 in dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# supabase (auth + postgres + rls) ... supabase dashboard > project settings > api
# ---------------------------------------------------------------------------
# the NEXT_PUBLIC_ pair is what the browser client reads ... required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-side copies (same values) ... required.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# the service role secret (bypasses rls) ... read by the admin client, the
# cron route, and the webhooks. required for prod; the app runs without it in
# dev but cron + webhooks refuse to work.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# cron + signing secrets ... generate with `openssl rand -hex 32`
# ---------------------------------------------------------------------------
# shared secret gating POST /api/cron/sequences. unset = the cron stays dark
# (404s). required for prod; vercel cron sends it automatically as a bearer
# token when this env var exists on the project.
CRON_SECRET=
# hmac secret signing the thread-routing tokens embedded in outbound
# message-ids ... inbound replies route to the right thread through it. fails
# closed in prod when unset. required for prod.
GEN_THREAD_SECRET=
# hmac secret signing unsubscribe links (falls back to GEN_THREAD_SECRET).
# fails closed in prod when both are unset. required for prod.
GEN_UNSUB_SECRET=
# hmac secret verifying POST /api/webhooks/calcom ... a booking on your cal.com
# link auto-marks the contact booked. cal.com webhook settings -> secret.
# unset = the hook stays dark (404s). required once you share your booking link.
CALCOM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# send mode + sender identity ... SAFE BY DEFAULT
# ---------------------------------------------------------------------------
# 'test' (default) redirects every send to GEN_TEST_RECIPIENT with the subject
# tagged [test->real-lead] ... no real lead is ever emailed. flip to 'live'
# only after the sending domain is verified in resend. optional (default test).
GEN_SEND_MODE=test
# the from-address for outbound mail. defaults to "gen <gen@lunari.pro>".
# optional; must sit on the verified sending domain for live mode.
GEN_SEND_FROM=
# the inbox test-mode sends land in (falls back to DEV_LOGIN_EMAIL).
# required when GEN_SEND_MODE=test (has a hardcoded owner fallback).
GEN_TEST_RECIPIENT=
# public origin used in unsubscribe links + mail footers (falls back to
# NEXT_PUBLIC_SITE_URL). optional.
GEN_PUBLIC_URL=
# the mailto address in the List-Unsubscribe header. defaults to
# unsubscribe@lunari.pro. optional.
GEN_UNSUB_MAILTO=
# the sender's physical postal address appended to cold first-touches
# (can-spam). required for live cold mail; omit it and the footer just lacks
# the address line.
GEN_POSTAL_ADDRESS=

# ---------------------------------------------------------------------------
# resend (sending + inbound + events) ... resend.com > api keys / webhooks
# ---------------------------------------------------------------------------
# resend api key ... required for any send, test or live.
RESEND_API_KEY=
# svix signing secret for POST /api/webhooks/resend (inbound replies +
# deliverability events). created when you register the webhook in resend.
# required for prod; in dev the webhook skips signature checks when unset.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# stripe billing ... SAFE BY DEFAULT: with these unset, billing is switched off
# (checkout returns a clean "not switched on yet", the webhook no-ops in dev /
# 503s in prod). to switch it on: paste the secret + webhook signing secret,
# then create the two recurring prices in stripe and drop their ids here.
#   creator ~$79/mo (80 fuel), pro ~$149/mo (200 fuel) ... 1 fuel = 1 qualified lead
# ---------------------------------------------------------------------------
# stripe secret key ... dashboard.stripe.com > developers > api keys.
# optional until you switch billing on.
STRIPE_SECRET_KEY=
# signing secret for POST /api/webhooks/stripe ... shown when you register
# the endpoint (dashboard > developers > webhooks). optional until live.
STRIPE_WEBHOOK_SECRET=
# price id for the creator plan (price_...). optional until live.
STRIPE_PRICE_CREATOR=
# price id for the pro plan (price_...). optional until live.
STRIPE_PRICE_PRO=

# ---------------------------------------------------------------------------
# ai models
# ---------------------------------------------------------------------------
# anthropic claude (planning + drafting + judge) ... console.anthropic.com.
# required ... gen + the drafting engine do not run without it.
ANTHROPIC_API_KEY=
# deepseek (the cheap workhorse model alongside claude) ... platform.deepseek.com.
# optional; the code treats an absent key as an empty string and that model
# path simply fails if called.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# lead discovery + enrichment providers ... all optional; each provider is
# skipped silently when its key is absent.
# ---------------------------------------------------------------------------
# apify key pool: comma-separated tokens. gen rotates across them with failover
# (one spent/rate-limited key rolls to the next). falls back to APIFY_TOKEN if
# the pool is unset. the durable record + monthly reset calendar lives in the
# gitignored config/apify-pool.local.json ... set APIFY_TOKEN_POOL from that
# manifest when folding gen connect into the lunari deploy env.
APIFY_TOKEN_POOL=
# single apify token fallback ... apify.com > settings > integrations.
APIFY_TOKEN=
# the apify actor for lead discovery + single-lead enrichment (e.g. boneswill/leads-generator)
APIFY_LEADS_ACTOR=
# the apify actor for live X/twitter signal search (tilde form). default (tested,
# free-tier-runnable): api-ninja~x-twitter-advanced-search. apidojo gates free runs.
APIFY_X_SEARCH_ACTOR=
# the apify actor for reddit signal search. default:
# practicaltools~apify-reddit-api. optional.
APIFY_REDDIT_SEARCH_ACTOR=
# apollo.io api key for contact enrichment ... apollo.io > settings > api.
APOLLO_API_KEY=
# hunter.io key for email finding ... hunter.io > api.
HUNTER_API_KEY=
# millionverifier key for email verification ... millionverifier.com > api.
MILLIONVERIFIER_API_KEY=
# neverbounce key for email verification ... neverbounce.com > app > api.
NEVERBOUNCE_API_KEY=
# perplexity (sonar enrichment) ... perplexity.ai > settings > api.
PERPLEXITY_API_KEY=
# base url of a crawl4ai instance for page scraping. optional.
CRAWL4AI_API_URL=
# github token raising the public-api footprint scan from 60/hr to 5000/hr
# ... github.com > settings > developer settings > tokens. optional.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# rate limiting + gen copilot cost guards
# ---------------------------------------------------------------------------
# upstash powers the per-user rate limit on /api/gen ... absent = always-allow (dev).
# upstash.com > redis > rest api. optional for dev, recommended for prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GEN_RATE_LIMIT_MAX=20         # max /api/gen calls per user per minute
GEN_DAILY_CEILING_CENTS=500   # paid-plan daily spend cap in cents (~$5/day)

# ---------------------------------------------------------------------------
# dev verify scripts (pnpm verify:*) ... dev only, never set in prod
# ---------------------------------------------------------------------------
# the owner login the verify scripts + test-mode fallback send to.
DEV_LOGIN_EMAIL=
# base url the verify scripts hit (defaults to http://localhost:3001).
VERIFY_BASE_URL=
# from-address the inbound verify script uses (defaults to gen <gen@lunari.pro>).
GEN_FROM_ADDRESS=
